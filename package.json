{
  "name": "valorant-locker",
  "version": "1.0.0",
  "description": "A desktop app for automatically selecting and locking agents in VALORANT.",
  "keywords": [
    "valorant",
    "riot",
    "instalocker",
    "electron",
    "typescript",
    "react",
    "vite",
    "tailwindcss"
  ],
  "author": "Sampreet Singh",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --dir",
    "package": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "productName": "VALORANT Locker",
    "appId": "com.sampreet.valorant-locker",
    "files": [
      "dist",
      "dist-electron"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1"
  }
}
